  "document": "query AttributeDetails($id: ID!, $firstValues: Int, $afterValues: String, $lastValues: Int, $beforeValues: String, $searchValues: String) {\n  attribute(id: $id) {\n    ...AttributeDetails\n    ...Metadata\n  }\n}\n\nfragment AttributeDetails on Attribute {\n  ...Attribute\n  availableInGrid\n  entityType\n  storefrontSearchPosition\n  valueRequired\n  referenceTypes {\n    ... on ProductType {\n      id\n      name\n    }\n    ... on PageType {\n      id\n      name\n    }\n  }\n  choices(\n    first: $firstValues\n    after: $afterValues\n    last: $lastValues\n    before: $beforeValues\n    search: $searchValues\n  ) {\n    ...AttributeValueList\n  }\n}\n\nfragment Attribute on Attribute {\n  id\n  name\n  slug\n  type\n  visibleInStorefront\n  filterableInDashboard\n  filterableInStorefront\n  unit\n  inputType\n}\n\nfragment AttributeValueList on AttributeValueCountableConnection {\n  pageInfo {\n    ...PageInfo\n  }\n  edges {\n    cursor\n    node {\n      ...AttributeValueDetails\n    }\n  }\n}\n\nfragment PageInfo on PageInfo {\n  endCursor\n  hasNextPage\n  hasPreviousPage\n  startCursor\n}\n\nfragment AttributeValueDetails on AttributeValue {\n  ...AttributeValue\n  plainText\n  richText\n}\n\nfragment AttributeValue on AttributeValue {\n  id\n  name\n  slug\n  file {\n    ...File\n  }\n  reference\n  boolean\n  date\n  dateTime\n  value\n}\n\nfragment File on File {\n  url\n  contentType\n}\n\nfragment Metadata on ObjectWithMetadata {\n  metadata {\n    ...MetadataItem\n  }\n  privateMetadata {\n    ...MetadataItem\n  }\n}\n\nfragment MetadataItem on MetadataItem {\n  key\n  value\n}",
