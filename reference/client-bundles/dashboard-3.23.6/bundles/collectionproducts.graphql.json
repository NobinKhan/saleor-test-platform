  "document": "query CollectionProducts($id: ID!, $first: Int, $after: String, $last: Int, $before: String) {\n  collection(id: $id) {\n    id\n    products(\n      first: $first\n      after: $after\n      before: $before\n      last: $last\n      sortBy: {field: COLLECTION, direction: ASC}\n    ) {\n      edges {\n        node {\n          ...CollectionProduct\n        }\n      }\n      pageInfo {\n        endCursor\n        hasNextPage\n        hasPreviousPage\n        startCursor\n      }\n    }\n  }\n}\n\nfragment CollectionProduct on Product {\n  id\n  name\n  productType {\n    id\n    name\n  }\n  thumbnail {\n    url\n  }\n  channelListings {\n    ...ChannelListingProductWithoutPricing\n  }\n}\n\nfragment ChannelListingProductWithoutPricing on ProductChannelListing {\n  id\n  isPublished\n  publishedAt\n  isAvailableForPurchase\n  availableForPurchaseAt\n  visibleInListings\n  channel {\n    id\n    name\n    slug\n    currencyCode\n  }\n}",
