  "document": "query SearchCategories($after: String, $first: Int!, $filter: CategoryFilterInput) {\n  search: categories(after: $after, first: $first, filter: $filter) {\n    edges {\n      node {\n        ...CategoryWithAncestors\n      }\n    }\n    pageInfo {\n      ...PageInfo\n    }\n  }\n}\n\nfragment CategoryWithAncestors on Category {\n  id\n  name\n  parent {\n    id\n    name\n  }\n  level\n  ancestors(first: 1) {\n    edges {\n      node {\n        id\n        name\n      }\n    }\n  }\n}\n\nfragment PageInfo on PageInfo {\n  endCursor\n  hasNextPage\n  hasPreviousPage\n  startCursor\n}",
