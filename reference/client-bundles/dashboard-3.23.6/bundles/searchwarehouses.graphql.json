  "document": "query SearchWarehouses($after: String, $first: Int!, $query: String!, $channnelsId: [ID!]) {\n  search: warehouses(\n    after: $after\n    first: $first\n    sortBy: {direction: ASC, field: NAME}\n    filter: {search: $query, channels: $channnelsId}\n  ) {\n    totalCount\n    edges {\n      node {\n        id\n        name\n      }\n    }\n    pageInfo {\n      ...PageInfo\n    }\n  }\n}\n\nfragment PageInfo on PageInfo {\n  endCursor\n  hasNextPage\n  hasPreviousPage\n  startCursor\n}",
