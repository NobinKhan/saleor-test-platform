  "document": "mutation ProductMediaUpdate($id: ID!, $alt: String!) {\n  productMediaUpdate(id: $id, input: {alt: $alt}) {\n    errors {\n      ...ProductError\n    }\n    product {\n      id\n      media {\n        ...ProductMedia\n      }\n    }\n  }\n}\n\nfragment ProductError on ProductError {\n  code\n  field\n  message\n}\n\nfragment ProductMedia on ProductMedia {\n  id\n  alt\n  sortOrder\n  url(size: 1024)\n  type\n  oembedData\n}",
