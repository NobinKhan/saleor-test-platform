  "document": "query SearchCategoriesWithTotalProducts($after: String, $first: Int!, $filter: CategoryFilterInput) {\n  search: categories(after: $after, first: $first, filter: $filter) {\n    edges {\n      node {\n        ...CategoryWithTotalProducts\n      }\n    }\n    pageInfo {\n      ...PageInfo\n    }\n  }\n}\n\nfragment CategoryWithTotalProducts on Category {\n  id\n  name\n  products {\n    totalCount\n  }\n}\n\nfragment PageInfo on PageInfo {\n  endCursor\n  hasNextPage\n  hasPreviousPage\n  startCursor\n}",
