  "document": "query CategoryDetails($id: ID!, $first: Int, $after: String, $last: Int, $before: String) {\n  category(id: $id) {\n    ...CategoryDetails\n    children(first: $first, after: $after, last: $last, before: $before) {\n      edges {\n        node {\n          ...Category\n        }\n      }\n      pageInfo {\n        ...PageInfo\n      }\n    }\n    products(first: $first, after: $after, last: $last, before: $before) {\n      pageInfo {\n        ...PageInfo\n      }\n      edges {\n        cursor\n        node {\n          id\n          name\n          thumbnail {\n            url\n          }\n        }\n      }\n    }\n  }\n}\n\nfragment CategoryDetails on Category {\n  id\n  ...Metadata\n  backgroundImage {\n    alt\n    url\n  }\n  name\n  slug\n  description\n  seoDescription\n  seoTitle\n  parent {\n    id\n  }\n  ancestors(first: 100) {\n    edges {\n      node {\n        id\n        name\n      }\n    }\n  }\n}\n\nfragment Metadata on ObjectWithMetadata {\n  metadata {\n    ...MetadataItem\n  }\n  privateMetadata {\n    ...MetadataItem\n  }\n}\n\nfragment MetadataItem on MetadataItem {\n  key\n  value\n}\n\nfragment Category on Category {\n  id\n  name\n  children {\n    totalCount\n  }\n  products {\n    totalCount\n  }\n}\n\nfragment PageInfo on PageInfo {\n  endCursor\n  hasNextPage\n  hasPreviousPage\n  startCursor\n}",
