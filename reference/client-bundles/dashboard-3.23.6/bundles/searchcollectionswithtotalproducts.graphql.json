  "document": "query SearchCollectionsWithTotalProducts($after: String, $first: Int!, $filter: CollectionFilterInput, $channel: String) {\n  search: collections(\n    after: $after\n    first: $first\n    filter: $filter\n    channel: $channel\n  ) {\n    edges {\n      node {\n        ...CollectionWithTotalProducts\n      }\n    }\n    pageInfo {\n      ...PageInfo\n    }\n  }\n}\n\nfragment CollectionWithTotalProducts on Collection {\n  id\n  name\n  products {\n    totalCount\n  }\n}\n\nfragment PageInfo on PageInfo {\n  endCursor\n  hasNextPage\n  hasPreviousPage\n  startCursor\n}",
