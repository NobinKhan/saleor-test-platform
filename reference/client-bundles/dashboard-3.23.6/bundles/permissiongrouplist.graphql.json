  "document": "query PermissionGroupList($after: String, $before: String, $first: Int, $last: Int, $filter: PermissionGroupFilterInput, $sort: PermissionGroupSortingInput) {\n  permissionGroups(\n    after: $after\n    before: $before\n    first: $first\n    last: $last\n    filter: $filter\n    sortBy: $sort\n  ) {\n    edges {\n      node {\n        ...PermissionGroup\n      }\n    }\n    pageInfo {\n      ...PageInfo\n    }\n  }\n}\n\nfragment PermissionGroup on Group {\n  id\n  name\n  userCanManage\n  users {\n    id\n    firstName\n    lastName\n  }\n}\n\nfragment PageInfo on PageInfo {\n  endCursor\n  hasNextPage\n  hasPreviousPage\n  startCursor\n}",
