{
  "bundle_id": "sf-featuredproductsquery",
  "source": "saleor-storefront",
  "source_path": "@next/graphql/queries.ts",
  "operation_names": [
    "FeaturedProductsQuery"
  ],
  "document": "query FeaturedProductsQuery($channel: String!) {\n  ...FeaturedProducts\n}\n\nfragment FeaturedProducts on Query {\n  collection(slug: \"featured-products\", channel: $channel) {\n    id\n    name\n    backgroundImage {\n      url\n    }\n    products(first: 20) {\n      edges {\n        node {\n          ...FeaturedProduct\n        }\n      }\n    }\n  }\n}\n\nfragment FeaturedProduct on Product {\n  ...BasicProductFields\n  ...ProductPricingField\n  category {\n    id\n    name\n  }\n}\n\nfragment BasicProductFields on Product {\n  id\n  slug\n  name\n  thumbnail {\n    url\n    alt\n  }\n  thumbnail2x: thumbnail(size: 510) {\n    url\n  }\n}\n\nfragment ProductPricingField on Product {\n  pricing {\n    onSale\n    priceRangeUndiscounted {\n      start {\n        ...TaxedPrice\n      }\n      stop {\n        ...TaxedPrice\n      }\n    }\n    priceRange {\n      start {\n        ...TaxedPrice\n      }\n      stop {\n        ...TaxedPrice\n      }\n    }\n  }\n}\n\nfragment TaxedPrice on TaxedMoney {\n  gross {\n    ...Price\n  }\n  net {\n    ...Price\n  }\n}\n\nfragment Price on Money {\n  amount\n  currency\n}",
  "variables": {
    "channel": "{{fixtures.default_channel}}"
  },
  "auth_context": "anonymous",
  "priority": "P0",
