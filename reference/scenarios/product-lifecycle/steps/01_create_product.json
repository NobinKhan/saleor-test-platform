{
  "step_id": "01_create_product",
  "name": "Create harness scenario product",
  "auth_context": "staff",
  "input_sent": "mutation ProductLifecycleCreate($input: ProductCreateInput!) { productCreate(input: $input) { product { id name slug } errors { field message code } } }",
  "variables": {
    "input": {
      "name": "Harness Scenario Product",
      "slug": "{{context.run_slug}}",
      "productType": "{{fixtures.default_product_type_id}}"
    }
  },
  "extract": {
    "created_product_id": "$.data.productCreate.product.id",
    "created_product_slug": "$.data.productCreate.product.slug"
  },
  "assertions": [
    {"kind": "path_exists", "path": "$.data.productCreate.product.id"},
    {"kind": "context_equals", "path": "$.data.productCreate.product.slug", "context_key": "run_slug"}
  ]
}
