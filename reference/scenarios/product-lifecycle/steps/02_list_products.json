{
  "step_id": "02_list_products",
  "name": "Fetch created product by ID",
  "auth_context": "staff",
  "input_sent": "query ProductLifecycleGet($id: ID!) { product(id: $id) { id slug name } }",
  "variables": {
    "id": "{{context.created_product_id}}"
  },
  "assertions": [
    {"kind": "context_equals", "path": "$.data.product.slug", "context_key": "run_slug"},
    {"kind": "context_equals", "path": "$.data.product.id", "context_key": "created_product_id"}
  ]
}
