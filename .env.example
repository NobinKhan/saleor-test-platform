# Host port overrides (when defaults conflict with other local services).
# Copy to .env in the repo root — docker compose loads it for port substitution.
#
# Internal container ports stay fixed; only host bindings change.

# Saleor GraphQL API (default 8000)
SALEOR_HOST_PORT=8000

# Harness backend API (default 5998)
HARNESS_BACKEND_HOST_PORT=5998

# Harness frontend UI (default 5999)
HARNESS_FRONTEND_HOST_PORT=5999

# Example when 8000 is busy:
# SALEOR_HOST_PORT=18000
# HARNESS_BACKEND_HOST_PORT=15998
# HARNESS_FRONTEND_HOST_PORT=15999

# Saleor admin (used by just baseline, patch-corpus, E2E)
SALEOR_ADMIN_EMAIL=admin@example.com
SALEOR_ADMIN_PASSWORD=admin123456

# Harness UI test user (just register)
HARNESS_USER_EMAIL=test@example.com
HARNESS_USER_PASSWORD=testpass123

# E2E certification (defaults to in-compose saleor-api; override for external backends)
# SALEOR_E2E_URL=http://host.docker.internal:18000/graphql/
