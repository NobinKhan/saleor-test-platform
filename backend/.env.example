# Backend environment variables for Saleor Test Platform
# Copy this file to .env and fill in the values

DATABASE_URL=postgresql+asyncpg://saleor_test:saleor_test_pass@harness-db:5432/saleor_test

# JWT Authentication — CHANGE THIS IN PRODUCTION
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_64CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet key for encrypting Saleor tokens at rest (generate with Python):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

APP_ENV=development
ALLOW_INSECURE_JWT_SECRET=true
APP_HOST=0.0.0.0
APP_PORT=5998
FRONTEND_URL=http://localhost:5999

# In Docker Compose, harness reaches Saleor via service name
# Docker harness: host Saleor on port 8000. Full stack (just up): saleor-api:8000 also works.
SALEOR_GRAPHQL_URL=http://host.docker.internal:8000/graphql/

# Reference baseline shown in reports (Saleor Dashboard compatibility catalog)
REFERENCE_BASELINE_VERSION=3.23.6
REFERENCE_BASELINE_SOURCE=saleor-dashboard
GOLDEN_CORPUS_VERSION=3.23.7
# URL of the golden reference Saleor instance (for record-reference / capture API)
REFERENCE_SALEOR_URL=http://host.docker.internal:8000/graphql/
