# Backend environment variables for Saleor Test Platform
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://saleor_test:saleor_test_pass@db:5432/saleor_test

# JWT Authentication — CHANGE THIS IN PRODUCTION
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_64CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Application
APP_HOST=0.0.0.0
APP_PORT=5998
FRONTEND_URL=http://localhost:5999
